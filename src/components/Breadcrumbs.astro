---
import { crumbSchema } from '../lib/seo';
import type { Crumb } from '../lib/seo';

interface Props {
  crumbs: Crumb[];
}

const { crumbs } = Astro.props;
const schema = crumbSchema(crumbs);
---

<nav aria-label="Breadcrumb" class="mb-6">
  <ol class="flex flex-wrap items-center gap-1.5 text-xs text-mute">
    {crumbs.map((c, i) => (
      <li class="flex items-center gap-1.5">
        {i > 0 && (
          <svg viewBox="0 0 24 24" class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
        )}
        {i < crumbs.length - 1 ? (
          <a href={c.href} class="transition-colors hover:text-blue">{c.label}</a>
        ) : (
          <span aria-current="page" class="font-semibold text-ink">{c.label}</span>
        )}
      </li>
    ))}
  </ol>
</nav>

<script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />

---
const links = [
  { href: '/', label: 'Generator' },
  { href: '/boy-names', label: 'Boy Names' },
  { href: '/girl-names', label: 'Girl Names' },
  { href: '/unisex-names', label: 'Unisex Names' },
  { href: '/shortlist', label: 'My Shortlist' },
  { href: '/about', label: 'About' },
];
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => current === href;
---

<header class="sticky top-0 z-50 border-b border-line bg-card/75 backdrop-blur-xl">
  <div class="mx-auto flex w-full max-w-6xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
    <a href="/" class="group flex items-center gap-2.5" aria-label="BabyNames home">
      <img src="/favicon.svg" alt="" width="32" height="32" class="h-8 w-8 shrink-0 rounded-[10px] transition-transform duration-300 group-hover:-rotate-6" />
      <span class="text-lg font-bold tracking-tight text-ink">Baby<span class="text-pink">Names</span></span>
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Primary">
      {links.map((l) => (
        <a
          href={l.href}
          aria-current={isActive(l.href) ? 'page' : undefined}
          class:list={[
            'rounded-full px-3.5 py-1.5 text-sm font-medium transition-colors',
            isActive(l.href)
              ? 'brand-solid'
              : 'text-ink-soft hover:bg-card-2 hover:text-ink',
          ]}
        >
          {l.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2.5">
      <button type="button" data-theme-toggle aria-label="Toggle dark mode" class="btn btn-ghost h-10 w-10" aria-pressed="false">
        <svg viewBox="0 0 24 24" class="h-5 w-5 dark:hidden" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
        <svg viewBox="0 0 24 24" class="hidden h-5 w-5 dark:block" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8Z" />
        </svg>
      </button>

      <a href="/shortlist" class="btn btn-ghost hidden h-10 items-center gap-2 px-4 text-sm sm:inline-flex" aria-label="View shortlist">
        <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21.2l7.8-7.8 1-1a5.5 5.5 0 0 0 0-7.8Z" />
        </svg>
        Shortlist
      </a>

      <details class="relative md:hidden" id="mobile-menu">
        <summary class="btn btn-ghost h-10 w-10 cursor-pointer list-none [&::-webkit-details-marker]:hidden" aria-label="Toggle menu">
          <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="M4 7h16M4 12h16M4 17h16" />
          </svg>
        </summary>
        <div class="glass-card absolute right-0 top-12 w-56 p-2">
          {links.map((l) => (
            <a
              href={l.href}
              aria-current={isActive(l.href) ? 'page' : undefined}
              class:list={[
                'block rounded-lg px-3 py-2.5 text-sm font-medium transition-colors',
                isActive(l.href) ? 'brand-solid' : 'text-ink-soft hover:bg-card-2 hover:text-ink',
              ]}
            >
              {l.label}
            </a>
          ))}
          <a href="/shortlist" class="btn btn-pink mt-2 w-full px-4 py-2.5 text-sm">My Shortlist</a>
        </div>
      </details>
    </div>
  </div>
</header>

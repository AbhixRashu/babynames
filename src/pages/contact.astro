---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, ORGANIZATION } from '../consts';

const title = 'Contact BabyNames — Free Baby Name Generator';
const description =
  'Contact the BabyNames team at Salary Pitcher Tools with questions, feedback or suggestions about the free baby name generator and our other free tools.';
---

<BaseLayout title={title} description={description}>
  <section class="pb-8 pt-2 sm:pt-6">
    <p class="eyebrow">Contact</p>
    <h1 class="mt-3 text-3xl font-bold tracking-tight text-ink sm:text-4xl">Contact Us</h1>
    <div class="prose-s mt-6 max-w-3xl">
      <p>
        Have a question, a feature request, or just want to say hello? We would love to hear from you. {SITE.name}
        is built and maintained by {ORGANIZATION.name}.
      </p>

      <h2>How to reach us</h2>
      <p>
        The fastest way to contact us is through the {ORGANIZATION.name} website:
      </p>
      <ul>
        <li>
          <strong>Main site:</strong>{' '}
          <a href={ORGANIZATION.url} rel="noopener" target="_blank">{ORGANIZATION.url}</a>
        </li>
        <li><strong>Email:</strong> use the contact form available on the main site.</li>
      </ul>

      <h2>What to include</h2>
      <p>To help us reply quickly, please mention:</p>
      <ul>
        <li>Which tool you are writing about (for example, the baby name generator).</li>
        <li>A short description of the issue or suggestion.</li>
        <li>If reporting a bug, your browser and device (e.g. "Chrome on Android").</li>
      </ul>

      <h2>Response time</h2>
      <p>
        We usually reply within a few business days. Thank you for helping us make the free tools better.
      </p>
    </div>
  </section>
</BaseLayout>

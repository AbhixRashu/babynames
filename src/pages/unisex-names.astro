---
import BaseLayout from '../layouts/BaseLayout.astro';
import Generator from '../components/Generator.astro';
import { NAMES } from '../lib/names';

const unisex = NAMES.filter((n) => n.gender === 'unisex');
const top = [...unisex].sort((a, b) => (a.rank ?? 999) - (b.rank ?? 999)).slice(0, 5);

const title = 'Unisex Baby Names — Gender-Neutral Names That Work for Any Child';
const description =
  'Discover stylish unisex and gender-neutral baby names with meanings and origins. Perfect for parents looking for modern, flexible name choices.';
---

<BaseLayout title={title} description={description}>
  <section class="pb-8 pt-2 sm:pt-6">
    <div class="max-w-3xl">
      <span class="badge-gender badge-unisex">Unisex names</span>
      <h1 class="mt-3 text-3xl font-bold tracking-tight text-ink sm:text-4xl">Unisex baby names with meanings</h1>
      <p class="mt-4 text-base leading-relaxed text-ink-soft">
        Gender-neutral names are a beautiful, modern choice — flexible enough to grow with your child and
        timeless enough to suit any personality. From nature-inspired picks like River and Wren to spiritual
        names like Noor and Kiran, explore unisex names from every origin and save your favourites to your
        shortlist.
      </p>
      <div class="mt-5 flex flex-wrap items-center gap-2 text-xs font-medium text-mute">
        <span class="flex items-center gap-1.5">
          <svg viewBox="0 0 24 24" class="h-4 w-4 text-pink" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M20 6 9 17l-5-5" /></svg>
          {unisex.length}+ unisex names
        </span>
        <span class="flex items-center gap-1.5">
          <svg viewBox="0 0 24 24" class="h-4 w-4 text-pink" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M20 6 9 17l-5-5" /></svg>
          Meanings & origins included
        </span>
      </div>
    </div>

    <div class="mt-6 grid gap-3 sm:grid-cols-5">
      {top.map((n) => (
        <div class="glass-card p-4">
          <p class="text-base font-bold text-ink">{n.name}</p>
          <p class="mt-1 text-xs leading-relaxed text-mute line-clamp-2">{n.meaning}</p>
        </div>
      ))}
    </div>
  </section>

  <section id="generator" class="scroll-mt-24">
    <Generator defaultGender="unisex" />
  </section>

  <section class="mt-14">
    <div class="max-w-2xl">
      <h2 class="text-2xl font-bold tracking-tight text-ink sm:text-3xl">Why choose a unisex name?</h2>
      <div class="prose-s mt-4">
        <p>
          Unisex names offer flexibility and style that never goes out of fashion. They're a favourite among
          modern parents who want a name that feels timeless, open-ended and full of possibility. Many unisex
          names carry beautiful meanings — light, peace, love — that work beautifully for any child, whatever
          path they choose in life.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

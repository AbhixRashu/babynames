---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'My Shortlist — Saved Baby Names';
const description =
  'View all the baby names you have saved to your shortlist. Remove names or clear the whole list anytime — everything is stored privately in your browser.';
---

<BaseLayout title={title} description={description}>
  <section class="pb-8 pt-2 sm:pt-6">
    <div class="max-w-3xl">
      <p class="eyebrow">Your favourites</p>
      <h1 class="mt-3 text-3xl font-bold tracking-tight text-ink sm:text-4xl">My shortlist</h1>
      <p class="mt-3 text-base leading-relaxed text-ink-soft">
        Every name you've hearted while browsing is saved here — privately on this device. Tap any name to see
        its full details and similar options.
      </p>
    </div>

    <div class="mt-6 flex items-center justify-between gap-3">
      <p class="text-sm font-semibold text-ink" data-shortlist-count></p>
      <button type="button" data-shortlist-clear class="btn btn-ghost px-4 py-2 text-sm" hidden>
        <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m3 0v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6" /></svg>
        Clear all
      </button>
    </div>

    <div data-shortlist-grid class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3"></div>

    <div data-shortlist-empty class="mt-4 rounded-2xl border border-dashed border-line-strong p-10 text-center" hidden>
      <svg viewBox="0 0 24 24" class="mx-auto h-10 w-10 text-mute" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21.2l7.8-7.8 1-1a5.5 5.5 0 0 0 0-7.8Z" />
      </svg>
      <h2 class="mt-4 text-lg font-bold text-ink">No names saved yet</h2>
      <p class="mx-auto mt-1 max-w-sm text-sm text-mute">
        Tap the heart on any name while browsing to add it to your shortlist.
      </p>
      <a href="/" class="btn btn-pink mt-5 px-6 py-2.5 text-sm">Start browsing names</a>
    </div>
  </section>

  <section class="mt-12">
    <div class="glass-card p-6 sm:p-8">
      <h2 class="text-lg font-bold text-ink">Comparing a few favourites?</h2>
      <p class="mt-2 max-w-2xl text-sm leading-relaxed text-ink-soft">
        Once you've shortlisted a handful of names, try the compatibility checker on the homepage to see how your
        top picks sound together as siblings or with your surname.
      </p>
      <a href="/#compatibility" class="btn btn-blue mt-4 px-6 py-2.5 text-sm">Try the compatibility checker</a>
    </div>
  </section>

  <div data-shortlist-modal class="modal-backdrop" hidden role="dialog" aria-modal="true">
    <div data-shortlist-modal-panel class="modal-panel"></div>
  </div>

  <script>
    import { mountShortlist } from '../scripts/shortlist';
    const root = document.querySelector<HTMLElement>('[data-shortlist-grid]')?.parentElement;
    if (root) mountShortlist(root);
  </script>
</BaseLayout>
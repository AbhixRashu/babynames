---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Generator from '../components/Generator.astro';
import { NAMES } from '../lib/names';
import { itemListSchema, HOME_CRUMB } from '../lib/seo';

const girls = NAMES.filter((n) => n.gender === 'girl');
const top = [...girls].sort((a, b) => (a.rank ?? 999) - (b.rank ?? 999)).slice(0, 20);

const title = 'Baby Girl Names — Beautiful, Elegant & Unique';
const description =
  'Browse hundreds of baby girl names with meanings and origins. Filter by religion, letter or meaning to find a beautiful, elegant name for your daughter.';

const crumbs = [HOME_CRUMB, { label: 'Girl Names', href: '/girl-names' }];
const listSchema = itemListSchema(top);
---

<BaseLayout title={title} description={description}>
  <script is:inline type="application/ld+json" slot="head" set:html={JSON.stringify(listSchema)} />
  <section class="pb-8 pt-2 sm:pt-6">
    <Breadcrumbs crumbs={crumbs} />
    <div class="max-w-3xl">
      <span class="badge-gender badge-girl">Girl names</span>
      <h1 class="mt-3 text-3xl font-bold tracking-tight text-ink sm:text-4xl">Baby girl names with meanings</h1>
      <p class="mt-4 text-base leading-relaxed text-ink-soft">
        Every little girl deserves a name as special as she is. From classic elegant names to modern favourites
        and beautiful names rooted in faith and culture, our collection spans every origin. Search by meaning —
        like light, grace or joy — filter by religion and starting letter, and save the ones you love to your
        shortlist.
      </p>
      <div class="mt-5 flex flex-wrap items-center gap-2 text-xs font-medium text-mute">
        <span class="flex items-center gap-1.5">
          <svg viewBox="0 0 24 24" class="h-4 w-4 text-pink" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M20 6 9 17l-5-5" /></svg>
          {girls.length}+ girl names
        </span>
        <span class="flex items-center gap-1.5">
          <svg viewBox="0 0 24 24" class="h-4 w-4 text-pink" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M20 6 9 17l-5-5" /></svg>
          Meanings & origins included
        </span>
      </div>
    </div>

    <div class="mt-6 grid gap-3 sm:grid-cols-5">
      {top.slice(0, 5).map((n) => (
        <div class="glass-card p-4">
          <p class="text-base font-bold text-ink">{n.name}</p>
          <p class="mt-1 text-xs leading-relaxed text-mute line-clamp-2">{n.meaning}</p>
        </div>
      ))}
    </div>
  </section>

  <section id="generator" class="scroll-mt-24">
    <Generator defaultGender="girl" />
  </section>

  <section class="mt-14">
    <div class="max-w-2xl">
      <h2 class="text-2xl font-bold tracking-tight text-ink sm:text-3xl">Popular girl names by origin</h2>
    </div>
    <div class="mt-6 grid gap-4 sm:grid-cols-3">
      <a href="/names/origin/hindu" class="glass-card hoverable p-6">
        <h3 class="text-lg font-bold text-ink">Hindu girl names</h3>
        <p class="mt-1.5 text-sm leading-relaxed text-ink-soft">Aaradhya, Ananya, Myra — graceful Sanskrit names that feel modern.</p>
      </a>
      <a href="/names/origin/muslim" class="glass-card hoverable p-6">
        <h3 class="text-lg font-bold text-ink">Muslim girl names</h3>
        <p class="mt-1.5 text-sm leading-relaxed text-ink-soft">Aaliyah, Fatima, Zainab — elegant names with rich Islamic meaning.</p>
      </a>
      <a href="/names/origin/western" class="glass-card hoverable p-6">
        <h3 class="text-lg font-bold text-ink">Western girl names</h3>
        <p class="mt-1.5 text-sm leading-relaxed text-ink-soft">Amelia, Charlotte, Evelyn — beloved names with timeless charm.</p>
      </a>
    </div>
  </section>

  <section class="mt-12">
    <div class="max-w-2xl">
      <h2 class="text-2xl font-bold tracking-tight text-ink sm:text-3xl">Explore more girl names</h2>
      <p class="mt-2 text-sm leading-relaxed text-ink-soft sm:text-base">
        Browse girl names by starting letter, origin or meaning, and see what is trending this year.
      </p>
    </div>
    <div class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      <a href="/names/starting-with" class="glass-card hoverable p-5">
        <h3 class="text-base font-bold text-ink">Girl names by letter</h3>
        <p class="mt-1 text-sm leading-relaxed text-ink-soft">Jump to any starting letter from A to Z.</p>
      </a>
      <a href="/names/origin" class="glass-card hoverable p-5">
        <h3 class="text-base font-bold text-ink">Girl names by origin</h3>
        <p class="mt-1 text-sm leading-relaxed text-ink-soft">Hindu, Muslim, Christian, Greek and many more traditions.</p>
      </a>
      <a href="/names/meaning" class="glass-card hoverable p-5">
        <h3 class="text-base font-bold text-ink">Girl names by meaning</h3>
        <p class="mt-1 text-sm leading-relaxed text-ink-soft">Names meaning love, grace, joy, light and more.</p>
      </a>
      <a href="/trending-baby-names-2026" class="glass-card hoverable p-5">
        <h3 class="text-base font-bold text-ink">Trending girl names 2026</h3>
        <p class="mt-1 text-sm leading-relaxed text-ink-soft">The most popular girl names parents are choosing this year.</p>
      </a>
      <a href="/boy-names" class="glass-card hoverable p-5">
        <h3 class="text-base font-bold text-ink">Baby boy names</h3>
        <p class="mt-1 text-sm leading-relaxed text-ink-soft">Strong, classic and unique boy names with meanings.</p>
      </a>
      <a href="/blog/unique-baby-names-2026" class="glass-card hoverable p-5">
        <h3 class="text-base font-bold text-ink">500+ unique baby names</h3>
        <p class="mt-1 text-sm leading-relaxed text-ink-soft">Fresh, rare and beautiful name ideas for 2026.</p>
      </a>
    </div>
  </section>
</BaseLayout>

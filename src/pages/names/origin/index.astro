---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import {
  namesByOrigin,
  ORIGINS_IN_DATA,
  originInfo,
  byRank,
  HOME_CRUMB,
} from '../../../lib/seo';

const origins = ORIGINS_IN_DATA.map((o) => {
  const all = namesByOrigin(o);
  return {
    origin: o,
    count: all.length,
    samples: byRank(all, 3).map((n) => n.name),
  };
});

const title = 'Baby Names by Origin — Indian, Hindu, Muslim & More';
const description =
  'Browse baby names by origin and religion, from Hindu, Muslim, Christian and Sikh to Greek, Latin, Hebrew, Japanese and beyond. Meanings included — free.';

const crumbs = [HOME_CRUMB, { label: 'Names by Origin', href: '/names/origin' }];
---

<BaseLayout title={title} description={description}>
  <Breadcrumbs crumbs={crumbs} />
  <section class="pb-8 pt-2 sm:pt-6">
    <div class="max-w-3xl">
      <span class="badge-gender badge-boy">Browse by origin</span>
      <h1 class="mt-3 text-3xl font-bold tracking-tight text-ink sm:text-4xl">Baby names by origin & religion</h1>
      <p class="mt-4 text-base leading-relaxed text-ink-soft">
        Culture, faith and family tradition often point parents toward a particular naming style. Choose an origin below to
        explore names from that tradition — Hindu, Muslim, Christian, Sikh, Greek, Latin, Hebrew, Japanese and many more — each
        with its meaning, origin and gender shown clearly. Whether you want to honour your heritage or simply love a particular
        sound, these pages make it easy to browse.
      </p>
      <p class="mt-3 text-base leading-relaxed text-ink-soft">
        Every origin page is sorted by popularity, so classics and modern favourites appear side by side. When a name catches
        your eye, open the free baby names generator, pick the origin and combine it with a starting letter, rashi or a meaning
        you love to refine your shortlist in seconds.
      </p>
    </div>
  </section>

  <section>
    <h2 class="text-2xl font-bold tracking-tight text-ink sm:text-3xl">Choose an origin</h2>
    <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {origins.map((o) => (
        <a href={`/names/origin/${o.origin.toLowerCase()}`} class="glass-card hoverable p-5">
          <h3 class="text-base font-bold text-ink">{o.origin} names</h3>
          <p class="mt-1 text-sm leading-relaxed text-ink-soft line-clamp-2">{originInfo(o.origin)}</p>
          <p class="mt-2 text-xs text-mute">{o.count}+ names · {o.samples.join(', ')}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="mt-12">
    <div class="max-w-2xl">
      <h2 class="text-2xl font-bold tracking-tight text-ink sm:text-3xl">More ways to explore names</h2>
    </div>
    <div class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      <a href="/boy-names" class="glass-card hoverable p-5">
        <h3 class="text-base font-bold text-ink">All baby boy names</h3>
        <p class="mt-1 text-sm leading-relaxed text-ink-soft">Strong, classic and unique boy names with meanings.</p>
      </a>
      <a href="/girl-names" class="glass-card hoverable p-5">
        <h3 class="text-base font-bold text-ink">All baby girl names</h3>
        <p class="mt-1 text-sm leading-relaxed text-ink-soft">Beautiful girl names from every tradition.</p>
      </a>
      <a href="/names/starting-with" class="glass-card hoverable p-5">
        <h3 class="text-base font-bold text-ink">Names by letter</h3>
        <p class="mt-1 text-sm leading-relaxed text-ink-soft">Jump to any starting letter A–Z.</p>
      </a>
      <a href="/names/meaning" class="glass-card hoverable p-5">
        <h3 class="text-base font-bold text-ink">Names by meaning</h3>
        <p class="mt-1 text-sm leading-relaxed text-ink-soft">Find names meaning love, light, strength and more.</p>
      </a>
      <a href="/trending-baby-names-2026" class="glass-card hoverable p-5">
        <h3 class="text-base font-bold text-ink">Trending names 2026</h3>
        <p class="mt-1 text-sm leading-relaxed text-ink-soft">The most popular names parents are choosing this year.</p>
      </a>
      <a href="/" class="glass-card hoverable p-5">
        <h3 class="text-base font-bold text-ink">Baby name generator</h3>
        <p class="mt-1 text-sm leading-relaxed text-ink-soft">Filter every name by letter, origin, meaning and more.</p>
      </a>
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = '404 — Page Not Found — Baby Name Generator';
const description =
  'Page not found on the free baby name generator. The page you were looking for does not exist, but thousands of baby boy, girl and unisex names are waiting.';
---

<BaseLayout title={title} description={description} noindex>
  <section class="flex min-h-[50vh] flex-col items-center justify-center py-16 text-center">
    <p class="eyebrow">404</p>
    <h1 class="mt-4 text-4xl font-bold tracking-tight text-ink sm:text-5xl">This page wandered off</h1>
    <p class="mx-auto mt-4 max-w-md text-base leading-relaxed text-ink-soft">
      The page you're looking for doesn't exist — but the perfect baby name is still out there.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="btn btn-pink px-7 py-3 text-sm">Back to the generator</a>
      <a href="/shortlist" class="btn btn-ghost px-6 py-3 text-sm">My shortlist</a>
    </div>
  </section>
</BaseLayout>
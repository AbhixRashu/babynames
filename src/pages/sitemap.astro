---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { LETTERS } from '../lib/names';
import { THEMES, ORIGINS_IN_DATA, HOME_CRUMB } from '../lib/seo';

const title = 'Sitemap — BabyNames Free Name Generator';
const description =
  'Full sitemap for the free baby name generator — browse every page including names by letter, origin and meaning, trending names, the blog and more.';

const crumbs = [HOME_CRUMB, { label: 'Sitemap', href: '/sitemap' }];

const sectionCls = 'glass-card p-6 sm:p-7';
const headingCls = 'text-base font-bold text-ink';
const listCls = 'mt-3 grid gap-1.5 text-sm';
const linkCls = 'text-ink-soft transition-colors hover:text-pink';
---

<BaseLayout title={title} description={description}>
  <Breadcrumbs crumbs={crumbs} />
  <section class="pb-8 pt-2 sm:pt-6">
    <div class="max-w-3xl">
      <p class="eyebrow">Sitemap</p>
      <h1 class="mt-3 text-3xl font-bold tracking-tight text-ink sm:text-4xl">Website sitemap</h1>
      <p class="mt-4 text-base leading-relaxed text-ink-soft">
        Every page on the free baby name generator in one place. Browse names by letter, origin or meaning,
        explore the trending ranking, read the blog or jump straight to the generator.
      </p>
    </div>
  </section>

  <section class="grid gap-4 sm:grid-cols-2">
    <div class={sectionCls}>
      <h2 class={headingCls}>Main pages</h2>
      <ul class={listCls}>
        <li><a class={linkCls} href="/">Baby Name Generator</a></li>
        <li><a class={linkCls} href="/boy-names">Baby Boy Names</a></li>
        <li><a class={linkCls} href="/girl-names">Baby Girl Names</a></li>
        <li><a class={linkCls} href="/unisex-names">Unisex Baby Names</a></li>
        <li><a class={linkCls} href="/trending-baby-names-2026">Trending Baby Names 2026</a></li>
        <li><a class={linkCls} href="/search">Baby Name Search</a></li>
        <li><a class={linkCls} href="/blog">Baby Name Blog</a></li>
      </ul>
    </div>

    <div class={sectionCls}>
      <h2 class={headingCls}>Names by letter</h2>
      <ul class={`${listCls} grid-cols-2 sm:grid-cols-3 lg:grid-cols-4`}>
        {LETTERS.map((l) => (
          <li><a class={linkCls} href={`/names/starting-with/${l.toLowerCase()}`}>Names starting with {l}</a></li>
        ))}
      </ul>
      <p class="mt-3 text-xs text-mute"><a class={linkCls} href="/names/starting-with">See all letters →</a></p>
    </div>

    <div class={sectionCls}>
      <h2 class={headingCls}>Names by origin</h2>
      <ul class={`${listCls} grid-cols-2 sm:grid-cols-2`}>
        {ORIGINS_IN_DATA.map((o) => (
          <li><a class={linkCls} href={`/names/origin/${o.toLowerCase()}`}>{o} Baby Names</a></li>
        ))}
      </ul>
      <p class="mt-3 text-xs text-mute"><a class={linkCls} href="/names/origin">See all origins →</a></p>
    </div>

    <div class={sectionCls}>
      <h2 class={headingCls}>Names by meaning</h2>
      <ul class={`${listCls} grid-cols-2 sm:grid-cols-3`}>
        {THEMES.map((t) => (
          <li><a class={linkCls} href={`/names/meaning/${t.slug}`}>Names meaning {t.label}</a></li>
        ))}
      </ul>
      <p class="mt-3 text-xs text-mute"><a class={linkCls} href="/names/meaning">See all meanings →</a></p>
    </div>
  </section>

  <section class="mt-4 grid gap-4 sm:grid-cols-2">
    <div class={sectionCls}>
      <h2 class={headingCls}>Blog</h2>
      <ul class={listCls}>
        <li><a class={linkCls} href="/blog">Blog home</a></li>
        <li><a class={linkCls} href="/blog/unique-baby-names-2026">500+ Unique Baby Names for 2026</a></li>
        <li><a class={linkCls} href="/blog/how-to-choose-baby-name">How to Choose the Perfect Baby Name</a></li>
        <li><a class={linkCls} href="/blog/trending-baby-names">Top 100 Trending Baby Names</a></li>
        <li><a class={linkCls} href="/blog/baby-names-around-the-world">Beautiful Baby Names from Around the World</a></li>
        <li><a class={linkCls} href="/blog/baby-names-by-zodiac">Baby Names by Zodiac Sign</a></li>
      </ul>
    </div>

    <div class={sectionCls}>
      <h2 class={headingCls}>Information</h2>
      <ul class={listCls}>
        <li><a class={linkCls} href="/about">About BabyNames</a></li>
        <li><a class={linkCls} href="/contact">Contact Us</a></li>
        <li><a class={linkCls} href="/privacy">Privacy Policy</a></li>
        <li><a class={linkCls} href="/terms">Terms of Service</a></li>
      </ul>
    </div>
  </section>
</BaseLayout>

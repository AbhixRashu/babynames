---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { POSTS, type Block } from '../../data/blog';
import { HOME_CRUMB, SITE_URL } from '../../lib/seo';

export function getStaticPaths() {
  return POSTS.map((p) => ({
    params: { slug: p.slug },
    props: { post: p },
  }));
}

const { post } = Astro.props;

const crumbs = [
  HOME_CRUMB,
  { label: 'Blog', href: '/blog' },
  { label: post.title, href: `/blog/${post.slug}` },
];

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.title,
  description: post.description,
  image: `${SITE_URL}/og.png`,
  datePublished: post.pubDate,
  dateModified: post.updatedDate,
  author: {
    '@type': 'Organization',
    name: 'Salary Pitcher Tools',
    url: 'https://salarypitcher.com',
  },
  publisher: {
    '@type': 'Organization',
    name: 'BabyNames',
    logo: {
      '@type': 'ImageObject',
      url: `${SITE_URL}/favicon-96x96.png`,
    },
  },
  mainEntityOfPage: `${SITE_URL}/blog/${post.slug}`,
};

const toc = post.blocks.filter((b): b is Extract<Block, { type: 'h2' }> => b.type === 'h2');
const slugify = (s: string) =>
  s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');

const inline = (text: string) =>
  text.replace(/\[\[([^|]+)\|([^\]]+)\]\]/g, '<a href="$2">$1</a>');
---

<BaseLayout
  title={post.title}
  description={post.description}
  type="article"
>
  <script is:inline type="application/ld+json" slot="head" set:html={JSON.stringify(articleSchema)} />

  <article class="mx-auto max-w-3xl">
    <Breadcrumbs crumbs={crumbs} />
    <header>
      <p class="text-xs font-semibold uppercase tracking-widest text-mute">
        Baby name blog · {post.pubDate} · {post.readingMinutes} min read
      </p>
      <h1 class="mt-3 text-3xl font-bold leading-tight tracking-tight text-ink sm:text-4xl">{post.title}</h1>
      <p class="mt-4 text-base leading-relaxed text-ink-soft">{post.description}</p>
    </header>

    {toc.length >= 4 && (
      <nav aria-label="Table of contents" class="glass-card mt-8 p-5 sm:p-6">
        <h2 class="text-sm font-bold uppercase tracking-wider text-mute">Table of contents</h2>
        <ol class="mt-3 space-y-2 text-sm">
          {toc.map((t, i) => (
            <li>
              <a href={`#${slugify(t.text)}`} class="text-ink-soft transition-colors hover:text-pink">
                {i + 1}. {t.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
    )}

    <div class="prose-s mt-8">
      {post.blocks.map((b) => {
        switch (b.type) {
          case 'p':
            return <p set:html={inline(b.text)} />;
          case 'h2':
            return <h2 id={slugify(b.text)} set:html={inline(b.text)} />;
          case 'h3':
            return <h3 set:html={inline(b.text)} />;
          case 'ul':
            return (
              <ul>
                {b.items.map((item) => (
                  <li set:html={inline(item)} />
                ))}
              </ul>
            );
          case 'table':
            return (
              <div class="glass-card my-6 overflow-x-auto">
                {b.caption && (
                  <p class="border-b border-line px-4 py-3 text-sm font-semibold text-ink">{b.caption}</p>
                )}
                <table class="w-full min-w-[560px] text-left text-sm">
                  <thead>
                    <tr class="border-b border-line text-xs uppercase tracking-wider text-mute">
                      {b.headers.map((h) => (
                        <th scope="col" class="px-4 py-3 font-semibold">{h}</th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {b.rows.map((row) => (
                      <tr class="border-b border-line last:border-0 hover:bg-card-2/60">
                        {row.map((cell) => (
                          <td class="px-4 py-2.5 text-ink-soft">{cell}</td>
                        ))}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            );
          case 'cta':
            return (
              <div class="mt-8 rounded-2xl p-6 sm:p-8" style="background: var(--pink-soft)">
                <p class="text-sm leading-relaxed text-ink sm:text-[15px]" set:html={inline(b.text)} />
                <a href="/" class="btn btn-pink mt-4 inline-flex px-7 py-3 text-sm">
                  Try the free generator →
                </a>
              </div>
            );
        }
      })}
    </div>
  </article>

  <section class="mt-14">
    <div class="max-w-2xl">
      <h2 class="text-2xl font-bold tracking-tight text-ink sm:text-3xl">Keep exploring</h2>
      <p class="mt-2 text-sm leading-relaxed text-ink-soft sm:text-base">
        More guides on the blog, and thousands of names to browse in the generator.
      </p>
    </div>
    <div class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {POSTS.filter((p) => p.slug !== post.slug).slice(0, 2).map((p) => (
        <a href={`/blog/${p.slug}`} class="glass-card hoverable p-5">
          <h3 class="text-base font-bold text-ink">{p.title}</h3>
          <p class="mt-1 text-sm leading-relaxed text-ink-soft line-clamp-2">{p.description}</p>
        </a>
      ))}
      <a href="/names/meaning" class="glass-card hoverable p-5">
        <h3 class="text-base font-bold text-ink">Names by meaning</h3>
        <p class="mt-1 text-sm leading-relaxed text-ink-soft">Browse hundreds of names by the meaning you love.</p>
      </a>
      <a href="/trending-baby-names-2026" class="glass-card hoverable p-5">
        <h3 class="text-base font-bold text-ink">Trending names 2026</h3>
        <p class="mt-1 text-sm leading-relaxed text-ink-soft">The most popular names this year, ranked.</p>
      </a>
      <a href="/" class="glass-card hoverable p-5">
        <h3 class="text-base font-bold text-ink">Baby name generator</h3>
        <p class="mt-1 text-sm leading-relaxed text-ink-soft">Filter every name by letter, origin, meaning and more.</p>
      </a>
    </div>
  </section>
</BaseLayout>
